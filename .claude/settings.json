{
  "permissions": {
    "deny": [
      "Read(/.env)",
      "Edit(/.env)",
      "Write(/.env)",
      "Edit(/.git/hooks/**)",
      "Write(/.git/hooks/**)",
      "Read(~/.clockify_env)",
      "Edit(~/.clockify_env)",
      "Write(~/.clockify_env)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git config core.hooksPath:*)",
      "Bash(gh pr review --approve:*)",
      "Bash(gh repo delete:*)"
    ],
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git push origin --delete:*)",
      "Bash(rm -rf:*)",
      "mcp__linear-server__save_issue"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read|mcp__linear-server__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/timer.py\" prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/timer.py\" stop",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/docs_guard.py\" stop"
          }
        ]
      }
    ]
  }
}
