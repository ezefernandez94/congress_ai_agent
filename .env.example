# Database
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/conference_bot

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=            # legacy single-user var, still honoured
TELEGRAM_ALLOWED_USER_IDS=           # comma-separated owner IDs, e.g. 123456,789012

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI (Whisper only)
OPENAI_API_KEY=

# Enrichment
PROXYCURL_API_KEY=
TAVILY_API_KEY=

# App
APP_ENV=development
WEBHOOK_SECRET=
BASE_URL=https://your-app.railway.app
RAILWAY_PUBLIC_DOMAIN=                # injected by Railway; overrides BASE_URL

# Web frontend
WEB_SESSION_SECRET=                   # random string, signs the browser session cookie
TELEGRAM_BOT_USERNAME=                # bot username without @, for the login widget
                                      # also run /setdomain in BotFather for the public domain

# Optional
APOLLO_API_KEY=
TIMEZONE=America/Los_Angeles
DIGEST_HOUR=7
DIGEST_MINUTE=30
